{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Pi GUI",
	"identifier": "com.pi.gui",
	"version": "0.1.0",
	"build": {
		"beforeDevCommand": "npx vite --port 1420",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "npm run build:frontend",
		"frontendDist": "../dist"
	},
	"app": {
		"withGlobalTauri": true,
		"macOSPrivateApi": true,
		"windows": [
			{
				"title": "Pi GUI",
				"width": 1100,
				"height": 750,
				"minWidth": 600,
				"minHeight": 400,
				"decorations": false,
				"transparent": true,
				"shadow": true,
				"backgroundColor": "#00000000",
				"center": true
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"publisher": "Pi GUI contributors",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"windows": {
			"allowDowngrades": false,
			"webviewInstallMode": {
				"type": "downloadBootstrapper",
				"silent": true
			},
			"nsis": {
				"installMode": "currentUser"
			},
			"wix": {
				"upgradeCode": "bc684a49-735f-5100-8ea3-5bb516c8f702"
			}
		},
		"linux": {
			"appimage": {
				"files": {
					"usr/share/metainfo/com.pi.gui.metainfo.xml": "linux/com.pi.gui.metainfo.xml"
				}
			},
			"deb": {
				"files": {
					"usr/share/metainfo/com.pi.gui.metainfo.xml": "linux/com.pi.gui.metainfo.xml"
				}
			},
			"rpm": {
				"files": {
					"usr/share/metainfo/com.pi.gui.metainfo.xml": "linux/com.pi.gui.metainfo.xml"
				}
			}
		}
	},
	"plugins": {
		"shell": {
			"open": true
		}
	}
}
